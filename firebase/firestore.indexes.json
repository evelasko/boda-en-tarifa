      "fields": [
        { "fieldPath": "rsvpStatus", "order": "ASCENDING" },
        { "fieldPath": "botEnrolled", "order": "ASCENDING" }
      ]
    },
    {
      "__comment": "Bot: open escalation queue ordered by createdAt",
      "collectionGroup": "bot_escalations",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "__comment": "Bot: priority-sorted escalation queue",
