rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Operator = admin custom claim OR a doc in /admins/{uid}.
    // The bot spec (bot/specs/04-data-model.md §4) standardizes on the
    // doc-based form; we accept both so existing custom-claim admins
    // keep working until/unless they're migrated.
    function isOperator() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // guests/{uid}
    match /guests/{uid} {
      allow read: if isAuthenticated();
      allow create: if false;
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['email', 'uid', 'side', 'relationToGrooms', 'profileClaimed', 'createdAt']);
      allow delete: if false;
    }

    // feed_posts/{postId}
    match /feed_posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isHidden'])
        && (resource.data.authorUid == request.auth.uid || isAdmin());
      allow delete: if false;
    }

    // notices/{noticeId}
    match /notices/{noticeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // seating/{guestUid}
    match /seating/{guestUid} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // app_config/{docId} — admin-only writes via Admin SDK; reads allowed to
    // operators (no PII, no need to expose to all signed-in users).
    match /app_config/{docId} {
      allow read: if isOperator();
      allow write: if false;
    }

    // rsvp_responses/{authUid} — one doc per signed-in user (doc id = Firebase Auth UID).
    // Admin linking fields are written only via Admin SDK (bypasses rules).
    match /rsvp_responses/{authUid} {
      allow read: if isOwner(authUid);
      allow create: if isOwner(authUid)
        && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(authUid)
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(authUid);
    }

    // time_gated_content/{contentId}
    match /time_gated_content/{contentId} {
      allow read: if isAuthenticated()
        && resource.data.unlockAt <= request.time;
      allow write: if false;
    }

    // ── Bot collections ───────────────────────────────────────────────
    // All bot writes happen server-side via Admin SDK (which bypasses
    // rules). Operator dashboard reads selected collections. Spec:
    // bot/specs/04-data-model.md §4.

    match /bot_conversations/{phone} {
      allow read: if isOperator();
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isOperator();
        allow write: if false;
      }
    }

    match /bot_dedupe/{id} {
      allow read, write: if false;
    }

    match /bot_send_log/{id} {
      allow read: if isOperator();
      allow write: if false;
    }

    match /bot_broadcasts/{id} {
      allow read: if isOperator();
      allow create, update: if isOperator();
      allow delete: if false;
    }

    match /bot_escalations/{id} {
      allow read: if isOperator();
      allow update: if isOperator();
      allow create, delete: if false;
    }

    match /bot_unknown_inbound/{id} {
      allow read: if isOperator();
      allow update: if isOperator();
      allow create, delete: if false;
    }

    match /bot_rate/{id} {
      allow read, write: if false;
    }

    match /bot_kb_version/{id} {
      allow read: if isOperator();
      allow write: if false;
    }

    match /bot_feedback/{id} {
      allow read: if isOperator();
      allow write: if false;
    }

    match /song_requests/{id} {
      allow read: if isOperator();
      allow write: if false;
    }

    match /bot_outbound_pending/{id} {
      allow read, write: if false;
    }

    // config/bot — operator-tunable bot config doc inside the existing
    // config/ collection. Other config/* docs are unaffected.
    match /config/bot {
      allow read, write: if isOperator();
    }
  }
}
